    "@angular/language-service": "^22.1.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.16.5",
    "autoprefixer": "^10.4.20",
    "minimist": "^1.2.8",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.3",
    "simple-git": "^3.30.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.7.0",
    "typescript": "6.0.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
