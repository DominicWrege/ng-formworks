{
	"schema": {
		"type": "object",
		"title": "Project Team",
		"description": "Array of objects — each member has four attributes. No custom layout.",
		"properties": {
			"project": {
				"type": "string",
				"title": "Project",
				"description": "Name of the project."
			},
			"deadline": {
				"type": "string",
				"format": "date",
				"title": "Deadline",
				"description": "Target delivery date."
			},
			"members": {
				"type": "array",
				"title": "Team members",
				"description": "Add or remove team members as needed.",
				"items": {
					"type": "object",
					"title": "Member",
					"description": "One team member.",
					"properties": {
						"name": {
							"type": "string",
							"title": "Name",
							"description": "Full name.",
							"minLength": 2
						},
						"role": {
							"type": "string",
							"title": "Role",
							"description": "Responsibility in the project.",
							"enum": ["lead", "developer", "designer", "tester"]
						},
						"email": {
							"type": "string",
							"format": "email",
							"title": "Email",
							"description": "Work address."
						},
						"active": {
							"type": "boolean",
							"title": "Active",
							"description": "Currently assigned?"
						}
					},
					"required": ["name", "role"]
				}
			}
		},
		"required": ["project", "members"]
	},
	"data": {
		"project": "Apollo",
		"deadline": "2026-11-30",
		"members": [
			{ "name": "Jane Doe", "role": "lead", "email": "jane@example.com", "active": true },
			{
				"name": "John Smith",
				"role": "developer",
				"email": "john@example.com",
				"active": true
			},
			{ "name": "Ana Lee", "role": "designer", "email": "ana@example.com", "active": false }
		]
	}
}
